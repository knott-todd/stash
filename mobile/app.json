{
  "expo": {
    "name": "Stash",
    "slug": "stash",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "stash",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.olusanyatodd.stash",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Stash backs up your photos and videos automatically.",
        "UIBackgroundModes": [
          "fetch",
          "processing"
        ],
        "BGTaskSchedulerPermittedIdentifiers": [
          "com.olusanyatodd.stash.backup"
        ]
      }
    },
    "android": {
      "package": "com.olusanyatodd.stash",
      "permissions": [
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "SEND",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "*/*"
            }
          ]
        },
        {
          "action": "SEND_MULTIPLE",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "*/*"
            }
          ]
        }
      ]
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Stash backs up your photos and videos automatically.",
          "savePhotosPermission": false,
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo",
            "video"
          ]
        }
      ],
      "expo-background-task",
      "expo-secure-store",
      "@react-native-google-signin/google-signin",
      "expo-font",
      "expo-video"
    ],
    "extra": {
      "googleWebClientId": "1075182560956-m3lnfgroma3ppcrimd5strbcq29144ji.apps.googleusercontent.com"
    }
  }
}
